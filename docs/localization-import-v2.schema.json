{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Localization source intake v2",
  "description": "源商品接收：不选择店铺及语言；完整商品和带币种最终售价库存由发送方提供。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "product",
    "publishing"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceSystem",
        "sourceProductId",
        "title",
        "description",
        "images",
        "parameters",
        "specificationNames",
        "variants",
        "weightKg",
        "dimensionsCm"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sourceSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceProductId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "images": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "minItems": 1
        },
        "parameters": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "specificationNames": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku",
              "options"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "options": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "stock": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "weightKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dimensionsCm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "width",
            "height"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets",
            "variantImages",
            "detailBlocks"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "url",
                  "role",
                  "textInImage"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "maxLength": 2048
                  },
                  "role": {
                    "enum": [
                      "gallery",
                      "detail",
                      "variant"
                    ]
                  },
                  "sourceLanguage": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "textInImage": {
                    "enum": [
                      "unknown",
                      "none",
                      "present"
                    ]
                  }
                }
              }
            },
            "variantImages": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sku",
                  "assetId"
                ],
                "properties": {
                  "sku": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            },
            "detailBlocks": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "text"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "assetId"
                    ],
                    "properties": {
                      "type": {
                        "const": "image"
                      },
                      "assetId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "variants"
      ],
      "properties": {
        "variants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku",
              "price",
              "stock"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "price": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "stock": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gtinCode": {
                "type": "string",
                "pattern": "^[0-9]{1,32}$"
              }
            }
          },
          "minItems": 1,
          "description": "完整对应product.variants全部SKU。price是currency币种最终售价。"
        },
        "condition": {
          "enum": [
            "NEW",
            "USED"
          ]
        },
        "preOrder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "isPreOrder"
          ],
          "properties": {
            "isPreOrder": {
              "type": "boolean"
            },
            "daysToShip": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217币种；只有与目标店铺币种一致时才能使用此最终售价。"
        },
        "marketPrices": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "currency",
              "variants"
            ],
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "ISO 4217币种；只有与目标店铺币种一致时才能使用此最终售价。"
              },
              "variants": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sku",
                    "price",
                    "stock"
                  ],
                  "properties": {
                    "sku": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "price": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "stock": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "gtinCode": {
                      "type": "string",
                      "pattern": "^[0-9]{1,32}$"
                    }
                  }
                },
                "minItems": 1,
                "description": "完整对应product.variants全部SKU。price是currency币种最终售价。"
              }
            }
          }
        }
      },
      "description": "商品的最终售价币种与库存；不接受来源市场类目、品牌、属性、物流或仓位ID。"
    }
  }
}
