{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Localization import v1",
  "description": "仿真完整商品接入契约：售价、库存、包装重量尺寸必填；目标类目及可复用的店铺配置由中台适配。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "product",
    "target"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceSystem",
        "sourceProductId",
        "title",
        "description",
        "images",
        "parameters",
        "specificationNames",
        "variants",
        "weightKg",
        "dimensionsCm"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sourceSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceProductId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "images": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "minItems": 1
        },
        "parameters": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "specificationNames": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku",
              "options"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "options": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "stock": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "weightKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dimensionsCm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "width",
            "height"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assets",
            "variantImages",
            "detailBlocks"
          ],
          "properties": {
            "assets": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "url",
                  "role",
                  "textInImage"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,100}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "maxLength": 2048
                  },
                  "role": {
                    "enum": [
                      "gallery",
                      "detail",
                      "variant"
                    ]
                  },
                  "sourceLanguage": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "textInImage": {
                    "enum": [
                      "unknown",
                      "none",
                      "present"
                    ]
                  }
                }
              }
            },
            "variantImages": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sku",
                  "assetId"
                ],
                "properties": {
                  "sku": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            },
            "detailBlocks": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "text"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "assetId"
                    ],
                    "properties": {
                      "type": {
                        "const": "image"
                      },
                      "assetId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionId",
        "country",
        "publishing"
      ],
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "使用目标店铺查询响应supportedLanguages中的原值，区分大小写；不是ISO语言代码。"
        },
        "publishing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variants"
          ],
          "properties": {
            "categoryId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "brandId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attributes": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "values"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "values": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50
                        }
                      }
                    }
                  }
                }
              }
            },
            "logistics": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "enabled"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "sizeId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "shippingFee": {
                    "type": "number",
                    "minimum": 0
                  },
                  "isFree": {
                    "type": "boolean"
                  }
                }
              }
            },
            "variants": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sku",
                  "price",
                  "stock"
                ],
                "properties": {
                  "sku": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "price": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "stock": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "locationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "gtinCode": {
                    "type": "string",
                    "pattern": "^[0-9]{1,32}$"
                  }
                }
              },
              "minItems": 1,
              "description": "提供时必须与product.variants的全部SKU一一对应且无重复；由服务端执行关联校验。price为目标店铺币种的最终售价。"
            },
            "condition": {
              "enum": [
                "NEW",
                "USED"
              ]
            },
            "preOrder": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "isPreOrder"
              ],
              "properties": {
                "isPreOrder": {
                  "type": "boolean"
                },
                "daysToShip": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            },
            "brandName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "description": "目标市场发布资料；目标ID由中台内部查询和适配，仿真无需提供。仅写入市场草稿，不改变来源快照。省略允许接收但不代表满足发布条件。"
        }
      }
    }
  }
}
